# ==============================================================================
# ResumeForge Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local development (Prisma CLI reads .env).
# Next.js also loads .env.local; keep DATABASE_URL in .env so migrate works.
# Never commit real API keys or secrets.
#
# Local:
#   docker compose up -d
#   npx prisma migrate deploy
#   npx prisma db seed
#   npm run dev
# Then open http://localhost:3000/login?mode=signup and choose your own password.
#
# scripts/check-env-parity.ts fails when code reads a name missing here.
# A commented KEY= line still counts as declared.

# Postgres (local docker-compose default). Only database. No SQLite URL.
DATABASE_URL="postgresql://resumeforge:resumeforge@localhost:5432/resumeforge"

# Signs the legacy rf_session cookie (min 8 characters). Not the login password.
# Do NOT prefix with NEXT_PUBLIC_. Restart npm run dev after changing this.
# Better Auth's secret name lands in the T2 cutover. This name stays until then.
APP_ACCESS_SECRET="change-me-to-a-long-random-secret"

# Optional shared-password fallback read by session checks. Leave empty for signup/login.
APP_ACCESS_PASSWORD=

# Required for POST /api/jobs/sync-pittcsc (fail-closed bearer).
JOB_SYNC_SECRET="change-me-sync-secret"

# Set by Node / Next (development | test | production). Do not commit a real override.
NODE_ENV=

# Public site origin used for metadata. No trailing path.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# "1" allows the in-memory DB mock in E2E runs when RESUME_FORGE_E2E=1 is also set. Leave unset in production.
RESUME_FORGE_ALLOW_MOCK_DB=
RESUME_FORGE_E2E=
# Set automatically by Vitest runner during unit tests.
# VITEST=
# Set only by the isolated PostgreSQL integration runner to use the real Prisma client.
VITEST_POSTGRES_INTEGRATION=

# Comma-separated extra hosts allowed for Tier 1 bulk-import sourceUrl.
ALLOWED_IMPORT_HOSTS=

# Override the SimplifyJobs markdown source. Default is the public Summer 2027 README.
SIMPLIFY_JOBS_URL=

# Indeed partner access. Both empty disables that fetcher path.
INDEED_MCP=
INDEED_PARTNER_KEY=

# Adzuna connector. Optional.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Server-side provider keys. Browser BYOK vault is separate and never stored here.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
GROQ_API_KEY=
OLLAMA_BASE_URL=

# Fallback provider labels read by the Typst repair route.
NEXT_PUBLIC_DEFAULT_AI_PROVIDER=
NEXT_PUBLIC_DEFAULT_AI_MODEL=

# Render: bind is `next start -H 0.0.0.0` (uses $PORT). See render.yaml.
