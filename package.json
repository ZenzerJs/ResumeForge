{
  "name": "resume-forge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env --experimental-strip-types scripts/run-postgres-integration.ts",
    "check:env": "tsx scripts/check-env-parity.ts",
    "generate:fixtures": "tsx scripts/generate-sample-resume-pdf.ts",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --config=playwright.demo.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "sync:oa": "tsx scripts/sync-oa-bank.ts",
    "seed:intel": "tsx scripts/seed-company-intel.ts",
    "normalize:jobs": "tsx scripts/normalize-job-descriptions.ts",
    "postinstall": "tsx scripts/copy-pdf-worker.ts"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@google/genai": "^2.29.1",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@uiw/react-codemirror": "^4.25.11",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.29",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "rehype-sanitize": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.1",
    "simple-icons": "^16.37.0",
    "tailwind-merge": "^3.0.1",
    "undici": "^7.30.2",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.9",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "deepmerge-ts": "^8.0.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
